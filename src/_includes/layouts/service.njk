---
layout: layouts/base.njk
---

<!-- Title and Banner (inside container) -->
<div class="container">
  <h1 class="page-title" data-cms-editable="title">{{ title }}</h1>
  {% if subtitle %}
    <p class="page-subtitle" data-cms-editable="subtitle">{{ subtitle }}</p>
  {% endif %}
  {% if heroImage %}
    <div class="banner">
      <img src="{{ heroImage }}" alt="{{ heroImageAlt or title }}">
    </div>
  {% endif %}
</div>

<!-- Main Content Area (container, row, columns) -->
<div class="container">
  <div class="row">
    <!-- Main Content -->
    <div class="main-content">
      <div data-cms-edit="content">
        {{ content | safe }}
      </div>
    </div>
    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="sidebar-contact">
        <strong>Alexandria Dental Health & Smile Studio</strong><br>
        2847 Duke St<br>
        Alexandria, VA 22314<br>
        <a href="tel:703-212-9622">(703) 212-9622</a>
      </div>
      <div class="sidebar-hours">
        <strong>Office Hours</strong><br>
        Monday 10:00am - 6:00pm<br>
        Tuesday 10:00am - 6:00pm<br>
        Wednesday 10:00am - 6:00pm<br>
        Thursday 9:00am - 4:00pm<br>
        Friday 8:00am - 1:00pm<br>
        <span class="sidebar-closed">Saturday & Sunday Closed</span>
      </div>
    </aside>
  </div>
</div>

<!-- Map (full width, above footer) -->
<div class="map">
  <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3105.013234567!2d-77.085!3d38.808!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89b7b0c6b0b0b0b0%3A0x0!2sAlexandria%20Dental%20Health%20%26%20Smile%20Studio!5e0!3m2!1sen!2sus!4v1680000000000!5m2!1sen!2sus" width="100%" height="220" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
</div>

<!-- Footer (full width, dark, columns) -->
<footer class="footer">
  <div class="footer-inner">
    <div class="footer-col">
      <h4>Alexandria Dental Health & Smile Studio</h4>
      <p>2847 Duke St<br>Alexandria, VA 22314</p>
      <p><a href="tel:703-212-9622">(703) 212-9622</a></p>
    </div>
    <div class="footer-col">
      <h4>Quick Links</h4>
      <a href="/about/">About</a>
      <a href="/contact-us/">Contact</a>
      <a href="/privacy-policy/">Privacy Policy</a>
    </div>
    <div class="footer-col">
      <h4>Our Services</h4>
      <a href="/dental-implants/">Dental Implants</a>
      <a href="/dental-bridges/">Dental Bridges</a>
      <a href="/invisalign/">Invisalign</a>
      <a href="/teeth-whitening/">Teeth Whitening</a>
    </div>
  </div>
  <div class="footer-copyright">
    &copy; 2025 Alexandria Dental Health & Smile Studio. All rights reserved.
  </div>
</footer>

<!-- CloudCannon Visual Editing Styles -->
<style>
    /* CloudCannon Visual Editor Styles */
    [data-cms-editable] {
        position: relative;
        transition: all 0.3s ease;
    }
    
    [data-cms-editable]:hover {
        background: rgba(0, 123, 255, 0.1) !important;
        cursor: pointer;
    }
    
    [data-cms-editable]::before {
        content: "✏️ Click to edit " attr(data-cms-editable);
        position: absolute;
        top: -25px;
        left: 10px;
        background: #007bff;
        color: white;
        padding: 2px 8px;
        border-radius: 3px;
        font-size: 0.75rem;
        opacity: 0;
        transition: opacity 0.3s ease;
        pointer-events: none;
        z-index: 1000;
    }
    
    [data-cms-editable]:hover::before {
        opacity: 1;
    }
    
    /* Responsive Design */
    @media (max-width: 768px) {
        .service-hero h1 {
            font-size: 2rem !important;
        }
        
        .service-hero p {
            font-size: 1.1rem !important;
        }
        
        .service-hero div a {
            display: block !important;
            margin: 10px 0 !important;
            text-align: center;
        }
        
        section[style*="grid-template-columns"] {
            grid-template-columns: 1fr !important;
        }
        
        [data-cms-editable]::before {
            display: none;
        }
    }
</style> 