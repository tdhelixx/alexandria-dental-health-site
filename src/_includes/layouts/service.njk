---
layout: layouts/base.njk
---

<!-- Title and Banner (inside container) -->
<div class="container" style="max-width:1220px;margin:0 auto;padding:40px 20px 0 20px;">
  <h1 data-cms-editable="title" style="text-align:center;font-size:2.7rem;font-weight:700;color:#32192f;margin-bottom:0.3em;letter-spacing:-1px;">{{ title }}</h1>
  {% if subtitle %}
    <p data-cms-editable="subtitle" style="text-align:center;color:#888;font-size:1.1rem;margin-bottom:2.5em;">{{ subtitle }}</p>
  {% endif %}
  {% if heroImage %}
    <div style="width:100%;margin-bottom:40px;">
      <img src="{{ heroImage }}" alt="{{ heroImageAlt or title }}" style="display:block;width:100%;height:300px;object-fit:cover;object-position:center;margin:0 auto;">
    </div>
  {% endif %}
</div>

<!-- Main Content Area (container, row, columns) -->
<div class="container" style="max-width:1220px;margin:0 auto 40px auto;padding:0 20px;">
  <div class="row" style="display:flex;flex-wrap:wrap;gap:40px;align-items:start;">
    <!-- Main Content (col-md-8) -->
    <div class="col-md-8" style="flex:0 0 66.666%;max-width:66.666%;min-width:300px;">
      <div data-cms-edit="content" style="line-height:1.7;font-size:1.08rem;color:#222;">
        {{ content | safe }}
      </div>
    </div>
    <!-- Sidebar (col-md-4) -->
    <aside class="col-md-4" style="flex:0 0 33.333%;max-width:33.333%;min-width:250px;padding-left:24px;">
      <div style="margin-bottom:2em;">
        <strong>Alexandria Dental Health & Smile Studio</strong><br>
        2847 Duke St<br>
        Alexandria, VA 22314<br>
        <a href="tel:703-212-9622" style="color:#32192f;text-decoration:none;">(703) 212-9622</a>
      </div>
      <div>
        <strong>Office Hours</strong><br>
        Monday 10:00am - 6:00pm<br>
        Tuesday 10:00am - 6:00pm<br>
        Wednesday 10:00am - 6:00pm<br>
        Thursday 9:00am - 4:00pm<br>
        Friday 8:00am - 1:00pm<br>
        <span style="color:#888;">Saturday & Sunday Closed</span>
      </div>
    </aside>
  </div>
</div>

<!-- Map (full width, above footer) -->
<div style="width:100vw;position:relative;left:50%;right:50%;margin-left:-50vw;margin-right:-50vw;margin-bottom:0;">
  <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3105.013234567!2d-77.085!3d38.808!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89b7b0c6b0b0b0b0%3A0x0!2sAlexandria%20Dental%20Health%20%26%20Smile%20Studio!5e0!3m2!1sen!2sus!4v1680000000000!5m2!1sen!2sus" width="100%" height="220" style="border:0;max-width:1220px;display:block;margin:0 auto;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
</div>

<!-- Footer (full width, dark, columns) -->
<footer style="background:#32192f;color:white;padding:40px 0 0 0;margin-top:0;">
  <div style="max-width:1220px;margin:0 auto;padding:0 20px;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:40px;">
    <div>
      <h4 style="color:white;margin-bottom:15px;font-size:1.1rem;">Alexandria Dental Health & Smile Studio</h4>
      <p style="margin:5px 0;color:rgba(255,255,255,0.8);">2847 Duke St<br>Alexandria, VA 22314</p>
      <p style="margin:10px 0;"><a href="tel:703-212-9622" style="color:#ffae00;text-decoration:none;">(703) 212-9622</a></p>
    </div>
    <div>
      <h4 style="color:white;margin-bottom:15px;font-size:1.1rem;">Quick Links</h4>
      <a href="/about/" style="color:#ffae00;text-decoration:none;display:block;margin-bottom:8px;">About</a>
      <a href="/contact-us/" style="color:#ffae00;text-decoration:none;display:block;margin-bottom:8px;">Contact</a>
      <a href="/privacy-policy/" style="color:#ffae00;text-decoration:none;display:block;margin-bottom:8px;">Privacy Policy</a>
    </div>
    <div>
      <h4 style="color:white;margin-bottom:15px;font-size:1.1rem;">Our Services</h4>
      <a href="/dental-implants/" style="color:#ffae00;text-decoration:none;display:block;margin-bottom:8px;">Dental Implants</a>
      <a href="/dental-bridges/" style="color:#ffae00;text-decoration:none;display:block;margin-bottom:8px;">Dental Bridges</a>
      <a href="/invisalign/" style="color:#ffae00;text-decoration:none;display:block;margin-bottom:8px;">Invisalign</a>
      <a href="/teeth-whitening/" style="color:#ffae00;text-decoration:none;display:block;margin-bottom:8px;">Teeth Whitening</a>
    </div>
  </div>
  <div style="text-align:center;color:rgba(255,255,255,0.7);margin-top:30px;padding-bottom:20px;font-size:0.95rem;">
    &copy; 2025 Alexandria Dental Health & Smile Studio. All rights reserved.
  </div>
</footer>

<!-- CloudCannon Visual Editing Styles -->
<style>
    /* CloudCannon Visual Editor Styles */
    [data-cms-editable] {
        position: relative;
        transition: all 0.3s ease;
    }
    
    [data-cms-editable]:hover {
        background: rgba(0, 123, 255, 0.1) !important;
        cursor: pointer;
    }
    
    [data-cms-editable]::before {
        content: "✏️ Click to edit " attr(data-cms-editable);
        position: absolute;
        top: -25px;
        left: 10px;
        background: #007bff;
        color: white;
        padding: 2px 8px;
        border-radius: 3px;
        font-size: 0.75rem;
        opacity: 0;
        transition: opacity 0.3s ease;
        pointer-events: none;
        z-index: 1000;
    }
    
    [data-cms-editable]:hover::before {
        opacity: 1;
    }
    
    /* Responsive Design */
    @media (max-width: 768px) {
        .service-hero h1 {
            font-size: 2rem !important;
        }
        
        .service-hero p {
            font-size: 1.1rem !important;
        }
        
        .service-hero div a {
            display: block !important;
            margin: 10px 0 !important;
            text-align: center;
        }
        
        section[style*="grid-template-columns"] {
            grid-template-columns: 1fr !important;
        }
        
        [data-cms-editable]::before {
            display: none;
        }
    }
</style> 