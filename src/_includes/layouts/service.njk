---
layout: layouts/base.njk
---

<div class="service-page">
    <!-- Hero Section -->
    <section class="service-hero">
        <div class="container">
            <div class="hero-content">
                <h1 data-cms-editable="title">{{ title }}</h1>
                <p data-cms-editable="subtitle">{{ subtitle or "Expert dental care in Alexandria, VA" }}</p>
                <div class="hero-buttons">
                    <a href="/contact-us/" class="btn btn-primary">Schedule Consultation</a>
                    <a href="tel:703-746-0077" class="btn btn-outline">Call Now</a>
                </div>
            </div>
        </div>
    </section>
    
    <!-- Main Content -->
    <section class="service-content">
        <div class="container">
            <div class="content-grid">
                <!-- Main Content Area -->
                <div class="main-content">
                    <div data-cms-edit="content">
                        {{ content | safe }}
                    </div>
                </div>
                
                <!-- Simple Sidebar -->
                <aside class="sidebar">
                    <div class="contact-card">
                        <h3>Schedule Appointment</h3>
                        <p>Call us today to get started</p>
                        <a href="tel:703-746-0077" class="phone-link">📞 703-746-0077</a>
                        <a href="/contact-us/" class="btn btn-primary btn-small">Book Online</a>
                    </div>
                </aside>
            </div>
        </div>
    </section>
</div>

<style>
/* Clean, simple styles */
.service-page {
    font-family: system-ui, -apple-system, sans-serif;
    line-height: 1.6;
}

.service-hero {
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    padding: 80px 0;
    text-align: center;
}

.hero-content h1 {
    font-size: 2.5rem;
    color: #212529;
    margin-bottom: 1rem;
    font-weight: 700;
}

.hero-content p {
    font-size: 1.1rem;
    color: #6c757d;
    margin-bottom: 2rem;
}

.hero-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
}

.btn {
    padding: 12px 24px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
    border: 2px solid transparent;
}

.btn-primary {
    background: #007bff;
    color: white;
}

.btn-primary:hover {
    background: #0056b3;
    transform: translateY(-1px);
}

.btn-outline {
    background: transparent;
    color: #007bff;
    border-color: #007bff;
}

.btn-outline:hover {
    background: #007bff;
    color: white;
}

.btn-small {
    padding: 8px 16px;
    font-size: 0.9rem;
}

.service-content {
    padding: 60px 0;
}

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
}

.content-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 3rem;
}

.main-content [data-cms-edit="content"] {
    background: #fdfdfd;
    border: 2px dashed #dee2e6;
    border-radius: 8px;
    padding: 2rem;
    min-height: 300px;
    position: relative;
}

.main-content [data-cms-edit="content"]:hover {
    border-color: #007bff;
    background: #f8f9ff;
}

.main-content [data-cms-edit="content"]::before {
    content: "✏️ Edit Content";
    position: absolute;
    top: 10px;
    right: 15px;
    background: #007bff;
    color: white;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 0.8rem;
    opacity: 0.8;
}

.sidebar {
    background: #f8f9fa;
    border-radius: 8px;
    padding: 2rem;
    height: fit-content;
}

.contact-card h3 {
    color: #212529;
    margin-bottom: 0.5rem;
    font-size: 1.2rem;
}

.contact-card p {
    color: #6c757d;
    margin-bottom: 1rem;
    font-size: 0.95rem;
}

.phone-link {
    display: block;
    color: #007bff;
    text-decoration: none;
    font-weight: 600;
    margin-bottom: 1rem;
    font-size: 1.1rem;
}

.phone-link:hover {
    color: #0056b3;
}

/* CloudCannon editing indicators */
[data-cms-editable] {
    outline: 2px dashed transparent;
    padding: 4px;
    border-radius: 4px;
    transition: all 0.2s ease;
}

[data-cms-editable]:hover {
    outline-color: #ffc107;
    background: rgba(255, 193, 7, 0.1);
}

/* Mobile responsive */
@media (max-width: 768px) {
    .content-grid {
        grid-template-columns: 1fr;
        gap: 2rem;
    }
    
    .hero-content h1 {
        font-size: 2rem;
    }
    
    .hero-buttons {
        flex-direction: column;
        align-items: center;
    }
    
    .btn {
        width: 200px;
        text-align: center;
    }
}
</style> 