---
layout: layouts/base.njk
---

<header class="site-header">
    <div class="container header-top-bar">
        <div class="logo">
            <img src="/images/logo.png" alt="Alexandria Dental Health & Smile Studio Logo">
        </div>
        <div class="header-actions">
            <span class="phone-number">(703) 212-9622</span>
            <a href="/special/" class="button-special">Special Offers</a>
            <a href="/contact-us/" class="button-schedule">Schedule Online</a>
        </div>
    </div>
    <nav class="main-nav">
        <div class="container">
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/about/">About</a></li>
                <li><a href="/patient-information/">Patients</a></li>
                <li><a href="/services/">Services</a></li>
                <li><a href="/concerns/">Conditions</a></li>
                <li><a href="/contact-us/">Contact</a></li>
            </ul>
        </div>
    </nav>
</header>

<main class="site-content">
    <div class="container page-container">
        <div class="content-layout">
            <div class="main-content-column">
                <h1 class="page-title" data-cms-editable="title">{{ title }}</h1>

                {% if heroImage %}
                <div class="featured-image" data-cms-editable="heroImage">
                    <img src="{{ heroImage }}" alt="{{ heroImageAlt or title }}">
                </div>
                {% endif %}
                
                <div class="content-editor-wrap" data-cms-edit="content">
                    {{ content | safe }}
                </div>
            </div>

            {% if show_sidebar !== false %}
            <aside class="sidebar">
                <div class="sidebar-widget">
                    <h4>Alexandria Dental Health & Smile Studio</h4>
                    <p>
                        2847 Duke St<br>
                        Alexandria VA 22314<br>
                        <a href="tel:703-212-9622">(703) 212-9622</a>
                    </p>
                </div>
                <div class="sidebar-widget">
                    <h4>OFFICE HOURS</h4>
                    <p>Monday: 10:00am - 6:00pm</p>
                    <p>Tuesday: 10:00am - 6:00pm</p>
                    <p>Wednesday: 10:00am - 6:00pm</p>
                    <p>Thursday: 9:00am - 4:00pm</p>
                    <p>Friday: 8:00am - 1:00pm</p>
                    <p>Saturday & Sunday: Closed</p>
                </div>
            </aside>
            {% endif %}
        </div>
    </div>
</main>

<footer class="site-footer">
    <div class="google-map">
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3109.430219491685!2d-77.09943898465248!3d38.80050857958569!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89b7b0f0b3f2b1c9%3A0xbf3e9f45c2f5e3e!2sAlexandria%20Dental%20Health%20%26%20Smile%20Studio!5e0!3m2!1sen!2sus!4v1626276701435!5m2!1sen!2sus" width="100%" height="450" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
    </div>
    <div class="footer-bottom-bar">
        <div class="container">
            <img src="/images/logo-footer.png" alt="Footer Logo" class="footer-logo">
            <div class="footer-links">
                <a href="/accessibility/">ACCESSIBILITY</a>
                <a href="/healthcare-disclaimer/">HEALTHCARE DISCLAIMER</a>
                <a href="/hipaa-privacy-policy/">HIPAA POLICY</a>
                <a href="/privacy-policy/">PRIVACY POLICY</a>
                <a href="/terms-service/">TERMS OF SERVICE</a>
                <a href="/good-faith-estimate/">GOOD FAITH ESTIMATE</a>
            </div>
            <p class="copyright">COPYRIGHT © 2025</p>
        </div>
    </div>
</footer>

<style>
    /* Reset and Base Styles */
    body {
        background-color: #f0f2f5;
        font-family: Arial, sans-serif;
        color: #333;
        margin: 0;
    }
    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
    }

    /* Header Styles */
    .site-header {
        background-color: #fff;
        padding: 10px 0;
        border-bottom: 1px solid #e0e0e0;
    }
    .header-top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 20px;
    }
    .logo img { max-height: 60px; }
    .header-actions { display: flex; align-items: center; gap: 15px; }
    .phone-number { font-weight: bold; font-size: 1.1rem; }
    .button-special { background-color: #f0ad4e; color: white; padding: 10px 20px; border-radius: 5px; text-decoration: none; font-weight: bold; }
    .button-schedule { background-color: #8c6e9b; color: white; padding: 10px 20px; border-radius: 5px; text-decoration: none; font-weight: bold; }

    /* Navigation Styles */
    .main-nav { background-color: #f8f8f8; border-top: 1px solid #e0e0e0; }
    .main-nav ul { list-style: none; margin: 0; padding: 0; display: flex; justify-content: center; gap: 40px; }
    .main-nav li a { display: block; padding: 15px 0; text-decoration: none; color: #333; font-weight: bold; }

    /* Main Content Styles */
    .site-content { padding: 40px 0; }
    .page-container {
        background-color: #fff;
        padding: 40px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.08);
        border-radius: 8px;
    }
    .content-layout {
        display: grid;
        grid-template-columns: {% if show_sidebar != false %}3fr 1fr{% else %}1fr{% endif %};
        gap: 40px;
    }

    /* Main Content Column */
    .page-title {
        font-size: 2.2rem;
        text-align: center;
        margin-bottom: 30px;
    }
    .featured-image img {
        width: 100%;
        height: auto;
        border-radius: 8px;
        margin-bottom: 30px;
    }
    .content-editor-wrap { line-height: 1.7; }
    .content-editor-wrap h2, .content-editor-wrap h3 { margin-top: 30px; }

    /* Sidebar Styles */
    .sidebar-widget { margin-bottom: 30px; }
    .sidebar-widget h4 { font-size: 1rem; color: #555; border-bottom: 1px solid #ddd; padding-bottom: 10px; margin-bottom: 10px; }
    .sidebar-widget p { margin: 5px 0; line-height: 1.6; }
    
    /* Footer Styles */
    .footer-bottom-bar { background-color: #2b2b2b; color: white; padding: 30px 0; text-align: center; }
    .footer-bottom-bar .container { display: flex; flex-direction: column; align-items: center; gap: 20px; }
    .footer-logo { max-height: 50px; }
    .footer-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 15px; }
    .footer-links a { color: #ccc; text-decoration: none; font-size: 0.8rem; }
    .copyright { font-size: 0.8rem; color: #888; }
    
    /* CloudCannon Editor Enhancement */
    body.cc-page-editor-open .content-layout {
        grid-template-columns: 1fr;
    }
    body.cc-page-editor-open .sidebar {
        display: none;
    }
</style> 