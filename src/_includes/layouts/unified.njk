---
layout: layouts/base.njk
---

<div class="unified-page">
    <!-- Simple Page Title -->
    <div class="page-header" style="padding: 40px 0 20px 0;">
        <div class="container" style="max-width: 1200px; margin: 0 auto; padding: 0 20px;">
            <h1 data-cms-editable="title" style="color: #333; font-size: 2.5rem; margin: 0; text-align: center;">{{ title }}</h1>
            {% if subtitle %}
                <p data-cms-editable="subtitle" style="color: #666; font-size: 1.2rem; text-align: center; margin: 20px 0 0 0;">{{ subtitle }}</p>
            {% endif %}
        </div>
    </div>

    <!-- Featured Image (Optional) - Full Width -->
    {% if heroImage %}
    <div class="featured-image" style="margin-bottom: 40px;">
        <div class="container" style="max-width: 1200px; margin: 0 auto; padding: 0 20px;">
            <img src="{{ heroImage }}" alt="{{ heroImageAlt or title }}" data-cms-editable="heroImage" style="width: 100%; height: 300px; object-fit: cover; border-radius: 8px;">
        </div>
    </div>
    {% endif %}

    <!-- Main Content Area - Starts AFTER banner -->
    <div class="main-content" style="padding: 20px 0 60px 0;">
        <div class="container" style="max-width: 1200px; margin: 0 auto; padding: 0 20px;">
            <div class="content-layout" style="display: grid; grid-template-columns: {% if show_sidebar !== false %}3fr 1fr{% else %}1fr{% endif %}; gap: 40px;">
                
                <!-- Content Area -->
                <div class="content-main">
                    <div data-cms-edit="content" style="background: #f8f9fa; border: 2px dashed #28a745; padding: 2rem; border-radius: 0.5rem; min-height: 200px; line-height: 1.6;">
                        {{ content | safe }}
                    </div>
                </div>

                <!-- Sidebar (Optional) -->
                {% if show_sidebar !== false %}
                <aside class="sidebar" style="background: #f8f9fa; padding: 30px; border-radius: 8px; height: fit-content;">
                    <!-- Practice Info -->
                    <div class="practice-info" style="text-align: center; margin-bottom: 30px;">
                        <h3 style="color: #333; margin-bottom: 15px; font-size: 1.3rem;">Alexandria Dental Health & Smile Studio</h3>
                        <p style="margin: 5px 0; color: #666;">2847 Duke St</p>
                        <p style="margin: 5px 0; color: #666;">Alexandria VA 22314</p>
                        <p style="margin: 15px 0;"><a href="tel:703-212-9622" style="color: #a27295; text-decoration: none; font-weight: bold;">(703) 212-9622</a></p>
                    </div>

                    <!-- Office Hours -->
                    <div class="office-hours">
                        <h4 style="color: #333; margin-bottom: 15px; text-align: center; font-size: 1.1rem;">OFFICE HOURS</h4>
                        <div style="space-y: 5px;">
                            <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                                <span style="font-weight: bold;">Monday</span>
                                <span>10:00am - 6:00pm</span>
                            </div>
                            <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                                <span style="font-weight: bold;">Tuesday</span>
                                <span>10:00am - 6:00pm</span>
                            </div>
                            <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                                <span style="font-weight: bold;">Wednesday</span>
                                <span>10:00am - 6:00pm</span>
                            </div>
                            <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                                <span style="font-weight: bold;">Thursday</span>
                                <span>9:00am - 4:00pm</span>
                            </div>
                            <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                                <span style="font-weight: bold;">Friday</span>
                                <span>8:00am - 1:00pm</span>
                            </div>
                            <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                                <span style="font-weight: bold;">Saturday & Sunday</span>
                                <span>Closed</span>
                            </div>
                        </div>
                    </div>

                    <!-- CTA Buttons -->
                    <div class="sidebar-cta" style="margin-top: 30px; text-align: center;">
                        <a href="/contact-us/" style="display: block; background: #ffae00; color: #000; padding: 12px 20px; border-radius: 25px; text-decoration: none; font-weight: bold; margin-bottom: 10px;">Schedule Appointment</a>
                        <a href="tel:703-212-9622" style="display: block; background: #a27295; color: white; padding: 12px 20px; border-radius: 25px; text-decoration: none; font-weight: bold;">Call Now</a>
                    </div>
                </aside>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<!-- Footer - Full Width -->
<footer style="background: #32192f; color: white; padding: 40px 0;">
    <div class="container" style="max-width: 1200px; margin: 0 auto; padding: 0 20px;">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 30px; margin-bottom: 30px;">
            <!-- Practice Info -->
            <div>
                <h4 style="color: white; margin-bottom: 15px;">Alexandria Dental Health & Smile Studio</h4>
                <p style="margin: 5px 0; color: rgba(255,255,255,0.8);">2847 Duke St</p>
                <p style="margin: 5px 0; color: rgba(255,255,255,0.8);">Alexandria, VA 22314</p>
                <p style="margin: 10px 0;"><a href="tel:703-212-9622" style="color: #ffae00; text-decoration: none;">(703) 212-9622</a></p>
            </div>
            
            <!-- Quick Links -->
            <div>
                <h4 style="color: white; margin-bottom: 15px;">Quick Links</h4>
                <ul style="list-style: none; padding: 0; margin: 0;">
                    <li style="margin-bottom: 8px;"><a href="/about/" style="color: rgba(255,255,255,0.8); text-decoration: none;">About</a></li>
                    <li style="margin-bottom: 8px;"><a href="/services/" style="color: rgba(255,255,255,0.8); text-decoration: none;">Services</a></li>
                    <li style="margin-bottom: 8px;"><a href="/contact-us/" style="color: rgba(255,255,255,0.8); text-decoration: none;">Contact</a></li>
                    <li style="margin-bottom: 8px;"><a href="/blog/" style="color: rgba(255,255,255,0.8); text-decoration: none;">Blog</a></li>
                </ul>
            </div>
            
            <!-- Services -->
            <div>
                <h4 style="color: white; margin-bottom: 15px;">Services</h4>
                <ul style="list-style: none; padding: 0; margin: 0;">
                    <li style="margin-bottom: 8px;"><a href="/dental-implants/" style="color: rgba(255,255,255,0.8); text-decoration: none;">Dental Implants</a></li>
                    <li style="margin-bottom: 8px;"><a href="/invisalign/" style="color: rgba(255,255,255,0.8); text-decoration: none;">Invisalign</a></li>
                    <li style="margin-bottom: 8px;"><a href="/teeth-whitening/" style="color: rgba(255,255,255,0.8); text-decoration: none;">Teeth Whitening</a></li>
                    <li style="margin-bottom: 8px;"><a href="/dental-bridges/" style="color: rgba(255,255,255,0.8); text-decoration: none;">Dental Bridges</a></li>
                </ul>
            </div>
        </div>
        
        <!-- Footer Bottom -->
        <div style="border-top: 1px solid rgba(255,255,255,0.2); padding-top: 20px; text-align: center;">
            <p style="margin: 0; color: rgba(255,255,255,0.6); font-size: 0.9rem;">
                © 2025 Alexandria Dental Health & Smile Studio. All rights reserved.
            </p>
        </div>
    </div>
</footer>

<!-- Responsive Design -->
<style>
    /* 
      CloudCannon Editor Enhancement:
      When the body has the class 'cc-page-editor-open' (added by CloudCannon's editor script),
      we automatically hide the website's content sidebar and expand the main content
      area to full width. This provides a much better editing experience by removing
      the "two sidebars" problem. The 'show_sidebar' front matter toggle will now
      only affect the appearance on the live, published site.
    */
    body.cc-page-editor-open .content-layout {
        grid-template-columns: 1fr; /* Force a single, full-width column */
    }

    body.cc-page-editor-open .sidebar {
        display: none; /* Hide the website's sidebar completely */
    }

    /* Original styles remain unchanged below */
    .unified-page {
        font-family: 'Helvetica Neue', Arial, sans-serif;
        color: #333;
        line-height: 1.6;
    }
    
    @media (max-width: 768px) {
        .content-layout {
            grid-template-columns: 1fr !important;
            gap: 20px !important;
        }
        
        .page-header h1 {
            font-size: 2rem !important;
        }
        
        .featured-image img {
            height: 200px !important;
        }
        
        .office-hours div {
            font-size: 0.9rem;
        }
    }
    
    /* Content Editor Styling */
    [data-cms-edit="content"] {
        transition: all 0.3s ease;
    }
    
    [data-cms-edit="content"]:hover {
        border-color: #007bff;
        background: rgba(0, 123, 255, 0.05);
    }
    
    [data-cms-editable] {
        transition: all 0.3s ease;
    }
    
    [data-cms-editable]:hover {
        outline: 2px dashed #ffc107;
        outline-offset: 2px;
    }
</style> 