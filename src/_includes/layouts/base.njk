<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if title %}{{ title }} - {% endif %}Alexandria Dental Health | Dentist in Alexandria, VA</title>
    
    <!-- Meta Tags -->
    <meta name="description" content="{{ description or 'Comprehensive dental care in Alexandria, VA. Dr. Mojgan Mazhari provides expert dental services including cosmetic dentistry, dental implants, Invisalign, and more.' }}">
    <meta name="keywords" content="{{ keywords or 'dentist Alexandria VA, dental implants, Invisalign, cosmetic dentistry, teeth whitening, dental care' }}">
    <meta name="author" content="Alexandria Dental Health">
    
    <!-- Open Graph -->
    <meta property="og:title" content="{% if title %}{{ title }} - {% endif %}Alexandria Dental Health">
    <meta property="og:description" content="{{ description or 'Comprehensive dental care in Alexandria, VA' }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ page.url | url | absoluteUrl(site.url) }}">
    
    <!-- Favicon -->
    <link rel="icon" type="image/webp" href="/wp-content/uploads/2025/01/Dentist-Alexandria-VA-Alexandria-Dental-Health-Smile-Studio-Favicon.webp">
    
    <!-- Stylesheets -->
    <link rel="stylesheet" href="/alexandria-dental-enhanced-styles.css">
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Additional CSS if needed -->
    {% if page_css %}
        <style>{{ page_css | safe }}</style>
    {% endif %}
</head>
<body>
    <!-- Header -->
    <header class="site-header">
        <div class="container">
            <div class="header-content">
                <div class="logo">
                    <a href="/">
                        <img src="/wp-content/uploads/2025/01/Dentist-Alexandria-VA-Alexandria-Dental-Health-Smile-Studio-Header-Logo.webp" 
                             alt="Alexandria Dental Health Logo" 
                             width="200" 
                             height="60">
                    </a>
                </div>
                
                <nav class="main-navigation">
                    <ul class="nav-menu">
                        <li><a href="/">Home</a></li>
                        <li><a href="/about/">About</a></li>
                        <li class="has-submenu">
                            <a href="/services/">Services</a>
                            <ul class="submenu">
                                <li><a href="/dental-implants/">Dental Implants</a></li>
                                <li><a href="/invisalign/">Invisalign</a></li>
                                <li><a href="/cosmetic-dentistry/">Cosmetic Dentistry</a></li>
                                <li><a href="/teeth-whitening/">Teeth Whitening</a></li>
                                <li><a href="/dental-crowns/">Dental Crowns</a></li>
                                <li><a href="/veneers/">Veneers</a></li>
                                <li><a href="/root-canal-therapy/">Root Canal Therapy</a></li>
                            </ul>
                        </li>
                        <li><a href="/smile-gallery/">Smile Gallery</a></li>
                        <li><a href="/blog/">Blog</a></li>
                        <li><a href="/contact-us/">Contact</a></li>
                    </ul>
                    
                    <div class="header-cta">
                        <a href="tel:703-746-0077" class="phone-number">703-746-0077</a>
                        <a href="/contact-us/" class="btn btn-primary">Schedule Appointment</a>
                    </div>
                </nav>
                
                <!-- Mobile Menu Toggle -->
                <button class="mobile-menu-toggle" aria-label="Toggle mobile menu">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="main-content">
        {% if hero_section %}
            <section class="hero-section">
                {{ hero_section | safe }}
            </section>
        {% endif %}
        
        {{ content | safe }}
    </main>

    <!-- Footer -->
    <footer class="site-footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <div class="footer-logo">
                        <img src="/wp-content/uploads/2025/01/Dentist-Alexandria-VA-Alexandria-Dental-Health-Smile-Studio-Footer-Logo.webp" 
                             alt="Alexandria Dental Health" 
                             width="180" 
                             height="50">
                    </div>
                    <p>Comprehensive dental care in Alexandria, VA. Dr. Mojgan Mazhari and our experienced team are dedicated to providing exceptional dental services in a comfortable, modern environment.</p>
                </div>
                
                <div class="footer-section">
                    <h3>Contact Info</h3>
                    <ul class="contact-info">
                        <li>
                            <strong>Phone:</strong> 
                            <a href="tel:703-746-0077">703-746-0077</a>
                        </li>
                        <li>
                            <strong>Address:</strong><br>
                            123 Dental Drive<br>
                            Alexandria, VA 22314
                        </li>
                        <li>
                            <strong>Email:</strong> 
                            <a href="mailto:info@alexandriadentalhealth.com">info@alexandriadentalhealth.com</a>
                        </li>
                    </ul>
                </div>
                
                <div class="footer-section">
                    <h3>Office Hours</h3>
                    <ul class="office-hours">
                        <li>Monday: 8:00 AM - 6:00 PM</li>
                        <li>Tuesday: 8:00 AM - 6:00 PM</li>
                        <li>Wednesday: 8:00 AM - 6:00 PM</li>
                        <li>Thursday: 8:00 AM - 6:00 PM</li>
                        <li>Friday: 8:00 AM - 4:00 PM</li>
                        <li>Saturday: 8:00 AM - 2:00 PM</li>
                        <li>Sunday: Closed</li>
                    </ul>
                </div>
                
                <div class="footer-section">
                    <h3>Quick Links</h3>
                    <ul class="footer-links">
                        <li><a href="/about/">About Us</a></li>
                        <li><a href="/services/">Our Services</a></li>
                        <li><a href="/patient-information/">Patient Information</a></li>
                        <li><a href="/dental-insurance-accepted/">Insurance</a></li>
                        <li><a href="/special/">Special Offers</a></li>
                        <li><a href="/contact-us/">Contact Us</a></li>
                    </ul>
                </div>
            </div>
            
            <div class="footer-bottom">
                <div class="footer-bottom-content">
                    <p>&copy; {% year %} Alexandria Dental Health. All rights reserved.</p>
                    <ul class="footer-legal">
                        <li><a href="/privacy-policy/">Privacy Policy</a></li>
                        <li><a href="/terms-service/">Terms of Service</a></li>
                        <li><a href="/accessibility/">Accessibility</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </footer>

    <!-- JavaScript -->
    <script>
        // Mobile menu toggle
        document.querySelector('.mobile-menu-toggle').addEventListener('click', function() {
            document.querySelector('.main-navigation').classList.toggle('mobile-open');
        });
        
        // Smooth scrolling for anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth' });
                }
            });
        });
    </script>
    
    {% if page_js %}
        <script>{{ page_js | safe }}</script>
    {% endif %}
</body>
</html> 