<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if title %}{{ title }} | {% endif %}Alexandria Dental Health & Smile Studio</title>
    <meta name="description" content="{{ description or 'Expert dental care in Alexandria VA with Dr. Mojgan Mazhari. Comprehensive dental services including implants, cosmetic dentistry, and family care.' }}">
    
    <!-- Simplified reliable styling -->
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            background: #fff;
        }
        
        .site-header {
            background: white;
            padding: 20px 0;
            border-bottom: 1px solid #ddd;
        }
        
        .header-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .practice-branding h1 {
            color: #a27295;
            font-size: 24px;
            margin: 0;
        }
        
        .header-contact a {
            color: #333;
            text-decoration: none;
            font-weight: bold;
        }
        
        .main-nav {
            background: #f8f9fa;
            padding: 15px 0;
        }
        
        .nav-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }
        
        .nav-menu {
            list-style: none;
            display: flex;
            gap: 30px;
            justify-content: center;
        }
        
        .nav-menu a {
            color: #666;
            text-decoration: none;
        }
        
        .nav-menu a:hover {
            color: #a27295;
        }
        
        .site-content {
            max-width: 1200px;
            margin: 0 auto;
            padding: 40px 20px;
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 40px;
        }
        
        .main-content {
            background: white;
            padding: 40px;
        }
        
        .sidebar {
            background: #f8f9fa;
            padding: 30px;
        }
        
        @media (max-width: 768px) {
            .header-container {
                flex-direction: column;
                gap: 15px;
            }
            
            .site-content {
                grid-template-columns: 1fr;
                gap: 30px;
            }
            
            .nav-menu {
                flex-direction: column;
                gap: 15px;
            }
        }
    </style>
</head>
<body>
    <header class="site-header">
        <div class="header-container">
            <div class="practice-branding">
                <h1>MOJGAN MAZHARI DDS</h1>
                <p>Alexandria Dental Health & Smile Studio</p>
            </div>
            
            <div class="header-contact">
                <a href="tel:703-212-9622">(703) 212-9622</a>
            </div>
        </div>
        
        <nav class="main-nav">
            <div class="nav-container">
                <ul class="nav-menu">
                    <li><a href="/">Home</a></li>
                    <li><a href="/about/">About</a></li>
                    <li><a href="/services/">Services</a></li>
                    <li><a href="/contact-us/">Contact</a></li>
                </ul>
            </div>
        </nav>
    </header>

    <div class="site-content">
        <main class="main-content">
            {{ content | safe }}
        </main>
        
        <aside class="sidebar">
            <h3>Alexandria Dental Health & Smile Studio</h3>
            <p><strong>2847 Duke St</strong><br>Alexandria VA 22314</p>
            <p><strong><a href="tel:703-212-9622">(703) 212-9622</a></strong></p>
        </aside>
    </div>
</body>
</html> 