---
layout: layouts/base.njk
---

<article class="blog-post">
    <header class="post-header">
        <div class="container">
            <div class="post-meta">
                <time datetime="{{ date }}">{{ date }}</time>
                {% if tags %}
                    <div class="post-tags">
                        {% for tag in tags %}
                            <span class="tag">{{ tag }}</span>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
            <h1 class="post-title">{{ title }}</h1>
            {% if excerpt %}
                <p class="post-excerpt">{{ excerpt }}</p>
            {% endif %}
            {% if featured_image %}
                <div class="post-featured-image">
                    <img src="{{ featured_image }}" alt="{{ title }}" loading="lazy">
                </div>
            {% endif %}
        </div>
    </header>
    
    <div class="post-content">
        <div class="container">
            <div class="post-layout">
                <div class="post-main">
                    {{ content | safe }}
                    
                    {% if author %}
                    <div class="post-author">
                        <div class="author-info">
                            {% if author.image %}
                                <img src="{{ author.image }}" alt="{{ author.name }}" class="author-avatar">
                            {% endif %}
                            <div class="author-details">
                                <h3>About {{ author.name }}</h3>
                                <p>{{ author.bio }}</p>
                            </div>
                        </div>
                    </div>
                    {% endif %}
                    
                    <div class="post-navigation">
                        {% if collections.blog %}
                            {% set previousPost = collections.blog | getPreviousCollectionItem(page) %}
                            {% set nextPost = collections.blog | getNextCollectionItem(page) %}
                            
                            {% if previousPost or nextPost %}
                                <nav class="post-nav">
                                    {% if previousPost %}
                                        <div class="nav-previous">
                                            <a href="{{ previousPost.url }}">
                                                <span class="nav-label">Previous Post</span>
                                                <span class="nav-title">{{ previousPost.data.title }}</span>
                                            </a>
                                        </div>
                                    {% endif %}
                                    
                                    {% if nextPost %}
                                        <div class="nav-next">
                                            <a href="{{ nextPost.url }}">
                                                <span class="nav-label">Next Post</span>
                                                <span class="nav-title">{{ nextPost.data.title }}</span>
                                            </a>
                                        </div>
                                    {% endif %}
                                </nav>
                            {% endif %}
                        {% endif %}
                    </div>
                </div>
                
                <aside class="post-sidebar">
                    <div class="sidebar-widget">
                        <h3>Schedule an Appointment</h3>
                        <p>Interested in learning more about the topics discussed in this post?</p>
                        <a href="/contact-us/" class="btn btn-primary btn-block">Contact Us Today</a>
                    </div>
                    
                    <div class="sidebar-widget">
                        <h3>Recent Posts</h3>
                        <ul class="recent-posts">
                            {% for post in collections.blog | head(5) %}
                                {% if post.url != page.url %}
                                    <li>
                                        <a href="{{ post.url }}">
                                            <span class="post-date">{{ post.date }}</span>
                                            <span class="post-title">{{ post.data.title }}</span>
                                        </a>
                                    </li>
                                {% endif %}
                            {% endfor %}
                        </ul>
                        <a href="/blog/" class="view-all-link">View All Posts</a>
                    </div>
                    
                    <div class="sidebar-widget">
                        <h3>Categories</h3>
                        <ul class="categories">
                            <li><a href="/blog/category/cosmetic-dentistry/">Cosmetic Dentistry</a></li>
                            <li><a href="/blog/category/dental-implants/">Dental Implants</a></li>
                            <li><a href="/blog/category/oral-health/">Oral Health</a></li>
                            <li><a href="/blog/category/preventive-care/">Preventive Care</a></li>
                            <li><a href="/blog/category/dental-technology/">Dental Technology</a></li>
                        </ul>
                    </div>
                    
                    <div class="sidebar-widget">
                        <h3>Connect With Us</h3>
                        <div class="contact-info">
                            <p><strong>Phone:</strong> <a href="tel:703-746-0077">703-746-0077</a></p>
                            <p><strong>Email:</strong> <a href="mailto:info@alexandriadentalhealth.com">info@alexandriadentalhealth.com</a></p>
                        </div>
                        <div class="social-links">
                            <!-- Add social media links here -->
                        </div>
                    </div>
                </aside>
            </div>
        </div>
    </div>
</article>

<section class="related-posts">
    <div class="container">
        <h2>Related Articles</h2>
        <div class="related-posts-grid">
            {% set relatedPosts = collections.blog | excludeItem(page) | head(3) %}
            {% for post in relatedPosts %}
                <article class="related-post">
                    {% if post.data.featured_image %}
                        <div class="post-image">
                            <a href="{{ post.url }}">
                                <img src="{{ post.data.featured_image }}" alt="{{ post.data.title }}" loading="lazy">
                            </a>
                        </div>
                    {% endif %}
                    <div class="post-content">
                        <time class="post-date">{{ post.date }}</time>
                        <h3 class="post-title">
                            <a href="{{ post.url }}">{{ post.data.title }}</a>
                        </h3>
                        {% if post.data.excerpt %}
                            <p class="post-excerpt">{{ post.data.excerpt }}</p>
                        {% endif %}
                        <a href="{{ post.url }}" class="read-more">Read More</a>
                    </div>
                </article>
            {% endfor %}
        </div>
    </div>
</section> 