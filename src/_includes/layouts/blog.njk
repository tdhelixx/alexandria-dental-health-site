---
layout: layouts/base.njk
---

<article class="blog-post">
    <header class="post-header">
        <div class="container">
            <div class="post-meta">
                <time datetime="{{ date }}">{{ date }}</time>
                {% if tags %}
                    <div class="post-tags">
                        {% for tag in tags %}
                            <span class="tag">{{ tag }}</span>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
            <h1 class="post-title">{{ title }}</h1>
            {% if excerpt %}
                <p class="post-excerpt">{{ excerpt }}</p>
            {% endif %}
            {% if featured_image %}
                <div class="post-featured-image">
                    <img src="{{ featured_image }}" alt="{{ title }}" loading="lazy">
                </div>
            {% endif %}
        </div>
    </header>
    
    <div class="post-content">
        <div class="container">
            <div class="post-layout">
                <div class="post-main">
                    {{ content | safe }}
                    
                    {% if author %}
                    <div class="post-author">
                        <div class="author-info">
                            {% if author.image %}
                                <img src="{{ author.image }}" alt="{{ author.name }}" class="author-avatar">
                            {% endif %}
                            <div class="author-details">
                                <h3>About {{ author.name }}</h3>
                                <p>{{ author.bio }}</p>
                            </div>
                        </div>
                    </div>
                    {% endif %}
                    
                    <div class="post-navigation">
                        <nav class="post-nav">
                            <div class="nav-center">
                                <a href="/blog/" class="btn btn-outline">← Back to Blog</a>
                            </div>
                        </nav>
                    </div>
                </div>
                
                <aside class="post-sidebar">
                    <div class="sidebar-widget">
                        <h3>Schedule an Appointment</h3>
                        <p>Interested in learning more about the topics discussed in this post?</p>
                        <a href="/contact-us/" class="btn btn-primary btn-block">Contact Us Today</a>
                    </div>
                    
                    <div class="sidebar-widget">
                        <h3>Connect With Us</h3>
                        <div class="contact-info">
                            <p><strong>Phone:</strong> <a href="tel:703-746-0077">703-746-0077</a></p>
                            <p><strong>Email:</strong> <a href="mailto:info@alexandriadentalhealth.com">info@alexandriadentalhealth.com</a></p>
                        </div>
                    </div>
                </aside>
            </div>
        </div>
    </div>
</article> 