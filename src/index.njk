---

<!-- Hero Section -->
<section class="hero-section" data-cms-bind="#hero">
  <div class="hero-banner">
    <div class="hero-content">
      <h1 data-cms-bind="#hero.title">{{ hero.title }}</h1>
      <p class="hero-subtitle" data-cms-bind="#hero.subtitle">{{ hero.subtitle }}</p>
      <div class="hero-buttons">
        {% for button in hero.buttons %}
          <a href="{{ button.url }}" class="btn btn-{{ button.style }}" data-cms-bind="#hero.buttons[{{ loop.index0 }}]">{{ button.text }}</a>
        {% endfor %}
      </div>
    </div>
    <div class="hero-image">
      <img src="{{ hero.image }}" 
           alt="Dr. Mojgan Mazhari - Alexandria Dental Health" 
           loading="eager"
           width="600" 
           height="500"
           data-cms-bind="#hero.image">
    </div>
  </div>
</section>

<!-- About Section -->
<section class="about-section" data-cms-bind="#about">
  <div class="container">
    <div class="about-content">
      <div class="about-text">
        <h2 data-cms-bind="#about.title">{{ about.title }}</h2>
        <p class="lead" data-cms-bind="#about.lead">{{ about.lead }}</p>
        
        <div class="about-highlights" data-cms-bind="#about.highlights">
          {% for highlight in about.highlights %}
          <div class="highlight" data-cms-bind="#about.highlights[{{ loop.index0 }}]">
            <h3 data-cms-bind="#about.highlights[{{ loop.index0 }}].title">{{ highlight.title }}</h3>
            <p data-cms-bind="#about.highlights[{{ loop.index0 }}].description">{{ highlight.description }}</p>
          </div>
          {% endfor %}
        </div>
        
        <a href="/about/" class="btn btn-outline">Learn More About Us</a>
      </div>
      <div class="about-image">
        <img src="{{ about.image }}" 
             alt="Dr. Mojgan Mazhari" 
             loading="lazy"
             width="500" 
             height="400"
             data-cms-bind="#about.image">
      </div>
    </div>
  </div>
</section>

<!-- Services Section -->
<section class="services-section" data-cms-bind="#services">
  <div class="container">
    <div class="section-header">
      <h2 data-cms-bind="#services.title">{{ services.title }}</h2>
      <p data-cms-bind="#services.subtitle">{{ services.subtitle }}</p>
    </div>
    
    <div class="services-grid" data-cms-bind="#services.featured_services">
      {% for service in services.featured_services %}
      <div class="service-card" data-cms-bind="#services.featured_services[{{ loop.index0 }}]">
        <div class="service-icon">
          <img src="{{ service.image }}" 
               alt="{{ service.title }}" 
               loading="lazy"
               data-cms-bind="#services.featured_services[{{ loop.index0 }}].image">
        </div>
        <h3 data-cms-bind="#services.featured_services[{{ loop.index0 }}].title">{{ service.title }}</h3>
        <p data-cms-bind="#services.featured_services[{{ loop.index0 }}].description">{{ service.description }}</p>
        <a href="{{ service.url }}" class="service-link" data-cms-bind="#services.featured_services[{{ loop.index0 }}].url">Learn More</a>
      </div>
      {% endfor %}
    </div>
    
    <div class="services-cta">
      <a href="/services/" class="btn btn-primary">View All Services</a>
    </div>
  </div>
</section>

<!-- Before & After Section -->
<section class="before-after-section">
  <div class="container">
    <div class="section-header">
      <h2>Smile Transformations</h2>
      <p>See the amazing results we've achieved for our patients</p>
    </div>
    
    <div class="gallery-preview">
      <div class="gallery-item">
        <div class="before-after">
          <div class="before">
            <img src="/images/placeholder.webp" 
                 alt="Before dental treatment" 
                 loading="lazy">
            <span class="label">Before</span>
          </div>
          <div class="after">
            <img src="/images/Dentist-Woman-Close-Up-Of-Pretty-Smile-CS1.webp" 
                 alt="After dental treatment" 
                 loading="lazy">
            <span class="label">After</span>
          </div>
        </div>
      </div>
      
      <div class="gallery-item">
        <div class="before-after">
          <div class="before">
            <img src="/images/placeholder.webp" 
                 alt="Before dental treatment" 
                 loading="lazy">
            <span class="label">Before</span>
          </div>
          <div class="after">
                      <img src="/images/Couple-Older-At-Beach-Smiling-CS1.webp" 
               alt="After dental treatment" 
               loading="lazy">
            <span class="label">After</span>
          </div>
        </div>
      </div>
      
      <div class="gallery-item">
        <div class="before-after">
          <div class="before">
            <img src="/images/placeholder.webp" 
                 alt="Before dental treatment" 
                 loading="lazy">
            <span class="label">Before</span>
          </div>
          <div class="after">
                      <img src="/images/Couple-Younger-Head-On-Shoulder-Smiling-CS1.webp" 
               alt="After dental treatment" 
               loading="lazy">
            <span class="label">After</span>
          </div>
        </div>
      </div>
    </div>
    
    <div class="gallery-cta">
      <a href="/smile-gallery/" class="btn btn-outline">View Complete Gallery</a>
    </div>
  </div>
</section>

<!-- Testimonials Section -->
<section class="testimonials-section" data-cms-bind="#testimonials">
  <div class="container">
    <div class="section-header">
      <h2 data-cms-bind="#testimonials.title">{{ testimonials.title }}</h2>
      <p data-cms-bind="#testimonials.subtitle">{{ testimonials.subtitle }}</p>
    </div>
    
    <div class="testimonials-grid" data-cms-bind="#testimonials.reviews">
      {% for testimonial in testimonials.reviews %}
      <div class="testimonial" data-cms-bind="#testimonials.reviews[{{ loop.index0 }}]">
        <div class="testimonial-content">
          <p data-cms-bind="#testimonials.reviews[{{ loop.index0 }}].content">"{{ testimonial.content }}"</p>
        </div>
        <div class="testimonial-author">
          <strong data-cms-bind="#testimonials.reviews[{{ loop.index0 }}].author">{{ testimonial.author }}</strong>
          <span data-cms-bind="#testimonials.reviews[{{ loop.index0 }}].treatment">{{ testimonial.treatment }}</span>
        </div>
      </div>
      {% endfor %}
    </div>
    
    <div class="testimonials-cta">
      <a href="/testimonials/" class="btn btn-outline">Read More Reviews</a>
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="cta-section" data-cms-bind="#final_cta">
  <div class="container">
    <div class="cta-content">
      <h2 data-cms-bind="#final_cta.title">{{ final_cta.title }}</h2>
      <p data-cms-bind="#final_cta.subtitle">{{ final_cta.subtitle }}</p>
      <div class="cta-buttons">
        {% for button in final_cta.buttons %}
          <a href="{{ button.url }}" class="btn btn-{{ button.style }}" data-cms-bind="#final_cta.buttons[{{ loop.index0 }}]">{{ button.text }}</a>
        {% endfor %}
      </div>
    </div>
  </div>
</section> 