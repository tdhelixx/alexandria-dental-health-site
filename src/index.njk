<!-- CloudCannon Visual Editing Styles -->
<style>
    /* Visual editing indicators and styles for homepage */
    .editable {
        outline: 2px dashed transparent;
        transition: all 0.3s ease;
        position: relative;
    }
    
    .editable:hover {
        outline-color: #ffc107;
        outline-offset: 2px;
        background: rgba(255, 193, 7, 0.1) !important;
    }
    
    .editable:focus,
    .editable.cms-selected {
        outline-color: #28a745 !important;
        outline-offset: 2px;
        background: rgba(40, 167, 69, 0.1) !important;
    }
    
    /* Section editing indicators */
    [data-cms-editable] {
        border: 2px dashed transparent;
        transition: all 0.3s ease;
        position: relative;
    }
    
    [data-cms-editable]:hover {
        border-color: #007bff !important;
        background: rgba(0, 123, 255, 0.05) !important;
    }
    
    [data-cms-editable]::before {
        content: "✏️ " attr(data-cms-editable);
        position: absolute;
        top: -25px;
        left: 10px;
        background: #007bff;
        color: white;
        padding: 2px 8px;
        border-radius: 3px;
        font-size: 0.75rem;
        opacity: 0;
        transition: opacity 0.3s ease;
        pointer-events: none;
        z-index: 1000;
    }
    
    [data-cms-editable]:hover::before {
        opacity: 1;
    }
    
    /* Card and item hover states */
    .service-card.editable:hover,
    .testimonial.editable:hover,
    .highlight.editable:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(0, 123, 255, 0.2) !important;
    }
    
    /* Responsive adjustments */
    @media (max-width: 768px) {
        [data-cms-editable]::before {
            display: none;
        }
        
        .editable:hover {
            outline-offset: 1px;
        }
    }
    
    /* CloudCannon editor mode styles */
    .cms-editor-active .editable {
        outline-color: #ffc107 !important;
    }
    
    .cms-editor-active [data-cms-editable] {
        border-color: #007bff !important;
    }
</style> 