        <p class="editable" data-cms-editable="services.featured_services[{{ loop.index0 }}].description">{{ service.description }}</p>
        <a href="{{ service.url }}" class="service-link editable" data-cms-editable="services.featured_services[{{ loop.index0 }}].url">Learn More</a>
